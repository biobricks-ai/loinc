    {
      "source": "R/download.R (this brick)",
      "quote": "download_url <- \"https://loinc.org/download/loinc-complete/\" ... message(\"You will need to create a free account at https://loinc.org/join/\") ... accept_license_form ... httr::POST(url = accept_license_form$action, body = list(tc_accepted = 1, tc_submit = \"Download\"), ...)",
      "confidence": "high"
    },
    {
      "source": "stages/01_download.sh + README.md (this brick)",
      "quote": "LOINC is a common language (set of identifiers, names, and codes) for identifying health measurements, observations, and documents. [downloaded from https://loinc.org/ after login and license acceptance]",
      "confidence": "high"
