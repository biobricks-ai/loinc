    },
    "proprietary (restricted class proxy: LOINC License is a controlled-access, click-through, copyright-bearing license, not an open/CC license)"
  ],
  "biobricks:licenseName": "LOINC License (Regenstrief Institute)",
  "biobricks:licenseClass": "restricted",
  "biobricks:merckCommercialUse": "conditional",
  "dcterms:creator": "Regenstrief Institute, Inc.",
